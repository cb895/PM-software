# =============================================================
# MetabolicTrack Lab PM — Environment Variables
# Copy this file to .env and fill in all values before running
# NEVER commit .env to version control
# =============================================================

# PostgreSQL password — choose a strong password
DB_PASSWORD=change_me_strong_password_here

# JWT secret key — generate with: openssl rand -hex 32
SECRET_KEY=change_me_generate_with_openssl_rand_hex_32

# Fernet encryption key for supplier credentials
# Generate with: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change_me_generate_with_python_fernet

# Allowed CORS origins (comma separated)
# Local network testing:
ALLOWED_ORIGINS=http://localhost,http://192.168.1.100

# When adding Tailscale or domain later, add here:
# ALLOWED_ORIGINS=http://localhost,http://192.168.1.100,https://labpm.metabolictrack.com

# App timezone
TZ=America/New_York

# Claude API for delay detection
ANTHROPIC_API_KEY=sk-ant-...

# Gmail SMTP (App Password — NOT your regular Gmail password)
# Generate at: myaccount.google.com/apppasswords
GMAIL_SENDER=cb@metabolictrack.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
